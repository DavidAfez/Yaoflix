# Postgres
DATABASE_URL=postgres://yaoflix:yaoflix@localhost:5432/yaoflix

# Public URL used in mails and WhatsApp links
APP_URL=http://localhost:3000

# Crypto. Generate each with: openssl rand -base64 32
# AES-256-GCM key for emails and phone numbers at rest
DATA_ENC_KEY=
# HMAC pepper for blind indexes (lookup without storing clear values)
HASH_PEPPER=

# Movie metadata (https://www.themoviedb.org/settings/api, "API Read Access Token")
TMDB_TOKEN=

# SMTP. Leave empty in dev: mails are printed in the worker console instead
SMTP_URL=
MAIL_FROM="GabaoFlix <no-reply@gabaoflix.local>"

# WhatsApp Cloud API (optional)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Approved template names (business initiated messages need templates)
WA_TEMPLATE_READY=
WA_TEMPLATE_FEEDBACK=

# Voice note transcription, any OpenAI compatible Whisper endpoint (optional)
# Free key: https://console.groq.com/keys
TRANSCRIBE_API_KEY=
TRANSCRIBE_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
TRANSCRIBE_MODEL=whisper-large-v3

# Where uploads, HLS renditions and voice notes live
MEDIA_ROOT=./storage

# First dev account created by `npm run db:seed`
SEED_DEV_HANDLE=root
SEED_DEV_EMAIL=
SEED_DEV_PASSWORD=
